{
  "manifest_version": 3,
  "name": "Map Scrapper",
  "version": "1.0.0",
  "description": "Google Maps theke business er name, phone, website, address, rating, email scrape kore CSV/JSON e export kore.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Map Scrapper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
